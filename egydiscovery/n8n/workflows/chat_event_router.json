{
  "name": "Chat Event Router",
  "nodes": [
    {
      "parameters": {
        "path": "chat_event",
        "methods": [
          "POST"
        ]
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Build a pseudo lead payload from chat\\nconst b = $json;\\nreturn [{source: 'chat', tag: b.event_type, name: b.user_id, message: b.text||'', score: 0}];"
      },
      "id": "Build",
      "name": "Build lead",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://backend:8000/api/v1/agents/route",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "prompt",
              "value": "=enrich: {{$json[\"message\"]}}"
            },
            {
              "name": "params",
              "value": "={ \"agent\": \"enrich\", \"payload\": { \"extract\": $json[\"message\"] } }"
            }
          ]
        }
      },
      "id": "Enrich",
      "name": "Enrich",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://backend:8000/api/v1/data/leads",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "source",
              "value": "=chat"
            },
            {
              "name": "tag",
              "value": "={{$json[\"tag\"]}}"
            },
            {
              "name": "payload",
              "value": "={{$json}}"
            }
          ]
        }
      },
      "id": "Save",
      "name": "Save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "responseMode": "lastNode",
        "responseData": "allEntries",
        "options": {
          "responseCode": 200
        }
      },
      "id": "Respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Build",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build": {
      "main": [
        [
          {
            "node": "Enrich",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enrich": {
      "main": [
        [
          {
            "node": "Save",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false
}