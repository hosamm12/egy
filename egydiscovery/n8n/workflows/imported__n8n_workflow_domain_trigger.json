      "parameters": {
        "functionCode": "// Verify a simple HMAC-like shared secret header; adjust as needed.\n// Expect header: X-Lead-Secret: <SECRET_VALUE>\nconst required = $json.headers?.['x-lead-secret'] || $json.headers?.['X-Lead-Secret'];\nconst expected = $env.N8N_LEAD_SHARED_SECRET || 'CHANGE_ME_SECRET';\nif (!required || required !== expected) {\n  // Stop execution by throwing an error (will send 401 from response node later)\n  throw new Error('Unauthorized: invalid or missing X-Lead-Secret');\n}\nreturn items;\n"
      },
      "id": "VerifySecret",
      "name": "Verify Shared Secret",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "functionCode": "// Normalize incoming JSON (from webhook body) into a standard lead schema.\n// Supports payloads like {name, email, phone, source, message, tags[], role, interest_score, url}\nconst now = new Date().toISOString();\nreturn items.map(item => {\n  const body = item.json.body || item.json; // depending on webhook config\n  const headers = item.json.headers || {};\n  const lead = {\n    id: body.id || body.lead_id || body.uuid || $jmespath(item.json, 'query.id') || $json.id || Date.now().toString(),\n    name: body.name || body.full_name || '',\n    email: body.email || '',\n    phone: body.phone || body.whatsapp || '',\n    role: body.role || '',\n    buyer_seller_hint: body.buyer_seller_hint || body.role || '',\n    source: body.source || headers['host'] || 'domain-webhook',\n    url: body.url || body.profile_url || '',\n    message: body.message || body.note || '',\n    tags: body.tags || [],\n    interest_score: Number(body.interest_score || 0),\n    created_at: now,\n  };\n  return { json: lead };\n});\n"
      },
