{
  "name": "Lead Ingest Router",
  "nodes": [
    {
      "parameters": {
        "path": "lead_ingest",
        "methods": [
          "POST"
        ]
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "functionCode": "// Normalize & defaults\\nconst b = $json;\\nconst score = Number(b.score || 0);\\nconst tag = (b.tag||'').toLowerCase();\\nreturn [{...b, score, tag}];"
      },
      "id": "Normalize",
      "name": "Normalize",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://backend:8000/api/v1/agents/route",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "prompt",
              "value": "=enrich: {{$json[\"message\"] || $json[\"url\"] || $json[\"email\"]}}"
            },
            {
              "name": "params",
              "value": "={ \"agent\": \"enrich\", \"payload\": { \"extract\": $json[\"message\"] || '' } }"
            }
          ]
        }
      },
      "id": "Enrich",
      "name": "Enrich (if missing score)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"score\"]}}",
              "operation": "smaller",
              "value2": 1
            }
          ]
        }
      },
      "id": "IF_no_score",
      "name": "IF: score missing/zero?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://backend:8000/api/v1/data/leads",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "source",
              "value": "={{$json[\"source\"] || 'form'}}"
            },
            {
              "name": "tag",
              "value": "={{$json[\"tag\"] || 'site'}}"
            },
            {
              "name": "payload",
              "value": "={{$json}}"
            }
          ]
        }
      },
      "id": "SaveLead",
      "name": "Save Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"score\"]}}",
              "operation": "largerEqual",
              "value2": 70
            }
          ]
        }
      },
      "id": "IF_high",
      "name": "IF: score >= 70",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        180
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json[\"score\"]}}",
              "operation": "largerEqual",
              "value2": 50
            },
            {
              "value1": "={{$json[\"score\"]}}",
              "operation": "smaller",
              "value2": 70
            }
          ]
        }
      },
      "id": "IF_mid",
      "name": "IF: 50 <= score < 70",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        380
      ]
    },
