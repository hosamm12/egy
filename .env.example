# ------- Global -------
COMPOSE_PROJECT_NAME=egysaas
ENV=development

# ------- Database -------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=egysaas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/egysaas

# ------- Redis -------
REDIS_URL=redis://REDIS_HOST:6379/0

# ------- Backend -------
SECRET_KEY=replace_with_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
BACKEND_CORS_ORIGINS=["https://egy-hosams-projects-92d52a96.vercel.app"]
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ------- Frontend -------
# HTTPS only. Leave empty to use the same Vercel origin. Do not use localhost.
NEXT_PUBLIC_API_URL=

# ------- Agents -------
AGENTS_BACKEND_URL=
