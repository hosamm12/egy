# ------- Global -------
COMPOSE_PROJECT_NAME=egysaas
ENV=development

# ------- Database -------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=egysaas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:change_me_postgres@postgres:5432/egysaas

# ------- Redis -------
REDIS_URL=redis://redis:6379/0

# ------- Backend -------
SECRET_KEY=replace_with_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithLongPass1

# ------- Frontend -------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------- Agents -------
AGENTS_BACKEND_URL=http://backend:8000
